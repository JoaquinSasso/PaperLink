<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
            Sin respaldo automático de Android en la nube: no puede llevar las fotos (tope de 25 MB)
            y restaurar solo la base y las preferencias deja códigos sin archivos y un estado de
            Drive que no corresponde. El respaldo en la nube es el de Google Drive de la app.
        -->
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Incluye base de datos, preferencias y todos los archivos de media/ sin tope de 25 MB -->
        <include domain="database" path="." />
        <include domain="file" path="media" />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
